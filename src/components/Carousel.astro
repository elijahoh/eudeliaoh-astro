---
interface Props {
  images: string[];
  title: string;
}

const { images = [], title } = Astro.props;
---

{images.length > 0 && (
  <div class="relative group w-full overflow-hidden rounded-2xl mb-8 shadow-md bg-neutral-950">
    <!-- Carousel Track -->
    <div id="carousel-track" class="flex transition-transform duration-500 ease-out w-full">
      {images.map((imgUrl, idx) => (
        <div class="w-full shrink-0 relative flex items-center justify-center min-h-[350px] max-h-[600px] overflow-hidden">
          
          <!-- Ambient Blurred Backdrop for Portrait Photos (Fills Empty Gaps) -->
          <img 
            src={imgUrl} 
            alt="" 
            class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-30 scale-110 pointer-events-none" 
          />
          
          <!-- Main Image Container -->
          <a href={imgUrl} target="_blank" rel="noopener noreferrer" class="relative z-10 block cursor-zoom-in max-h-[600px] py-2 w-full">
            <img
              src={imgUrl}
              alt={`${title} - image ${idx + 1}`}
              class="max-h-[580px] w-auto max-w-full object-contain mx-auto rounded-lg shadow-2xl transition-transform duration-300 group-hover:scale-[1.01]"
            />
          </a>
        </div>
      ))}
    </div>

    {/* Navigation Controls */}
    {images.length > 1 && (
      <>
        <button
          id="prev-btn"
          aria-label="Previous Image"
          class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-black/90 text-white p-3 rounded-full backdrop-blur-md transition-all shadow-lg cursor-pointer z-20"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
        </button>

        <button
          id="next-btn"
          aria-label="Next Image"
          class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-black/90 text-white p-3 rounded-full backdrop-blur-md transition-all shadow-lg cursor-pointer z-20"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
        </button>

        <div id="carousel-counter" class="absolute bottom-3 left-3 bg-black/70 text-white text-xs font-semibold px-3 py-1.5 rounded-full backdrop-blur-md shadow-md z-20">
          1 / {images.length}
        </div>
      </>
    )}
  </div>
)}

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const counter = document.getElementById('carousel-counter');

  if (track && prevBtn && nextBtn) {
    const total = track.children.length;
    let current = 0;

    const update = () => {

      track.style.transform = `translateX(-${current * 100}%)`;
      if (counter) counter.textContent = `${current + 1} / ${total}`;
    };

    prevBtn.addEventListener('click', () => {
      current = current === 0 ? total - 1 : current - 1;
      update();
    });

    nextBtn.addEventListener('click', () => {
      current = current === total - 1 ? 0 : current + 1;
      update();
    });
  }
</script>
