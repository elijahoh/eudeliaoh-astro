---
interface Props {
  _id?: string;
  _type?: string;
  title: string;
  category: string;
  image: string;
  slug?: string;
  description?: string;
  tags?: string[];
  pinned?: boolean;
  href?: string;
  reverse?: boolean;
  date?: string;
  readTime?: string;
}

const {
  _id,
  _type,
  title,
  category,
  image,
  slug,
  description,
  tags = [],
  pinned = false,
  href = "#",
  reverse = false,
  date = "2026-08-16",
  readTime = "2 min read",
} = Astro.props;

// Route calculation: uses _type ('portfolio' -> /portfolio/slug, 'post' -> /blog/slug) to prevent 404 errors when category is a discipline name
const routePrefix = _type === 'post' ? 'blog' : (_type === 'portfolio' ? 'portfolio' : category.toLowerCase());
const computedHref = href !== "#" ? href : (slug ? `/${routePrefix}/${slug}` : "#");
---

<div class="group relative block overflow-hidden rounded-2xl custom-card-shadow transition-all duration-300 transform hover:-translate-y-1 bg-[var(--color-card-bg)]">

  <div class={`flex flex-col ${reverse ? 'sm:flex-row-reverse' : 'sm:flex-row'} items-stretch sm:h-[var(--card-height)] bg-[var(--color-card-bg)]`}>

    <!-- Photo Container with Slanted Cutout -->
    <div class={`relative overflow-hidden w-full sm:w-5/12 shrink-0 bg-gray-100 dark:bg-slate-800 min-h-[200px] sm:min-h-full ${reverse ? 'card-slant-right' : 'card-slant-left'}`}>
      <img
        src={image}
        alt={title}
        class="card-image w-full h-full object-cover transition-transform duration-500 ease-out"
        loading="lazy"
      />
      {pinned && (
        <span class="card-pinned-badge absolute top-3 left-3 font-semibold px-2.5 py-1 rounded-full shadow-md z-20 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
          </svg>
          Pinned
        </span>
      )}
    </div>

    <!-- Details Container -->
    <div class={`p-6 flex flex-col justify-between flex-1 bg-[var(--color-card-bg)] h-full ${reverse ? 'sm:pr-6 sm:pl-10' : 'sm:pl-10 sm:pr-6'}`}>
      <div>
        <!-- Category & Vector Meta Row -->
        <div class="flex flex-wrap items-center gap-4 font-medium mb-2" style="font-size: var(--card-meta-size); color: var(--color-card-meta);">
          <span class="card-category font-bold uppercase tracking-wider">
            {category}
          </span>

          <span class="meta-date flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {date}
          </span>

          <span class="meta-readtime flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 16 14"></polyline>
            </svg>
            {readTime}
          </span>
        </div>

        <!-- Card Title -->
        <h3 class="card-title font-bold line-clamp-1 mb-2 transition-colors">
          {title}
        </h3>

        <!-- Card Description -->
        {description && (
          <p class="card-description line-clamp-2 leading-relaxed">
            {description}
          </p>
        )}
      </div>

      <!-- Tag Pills & More Action Button -->
      <div class="flex items-center justify-between mt-4">
        <!-- Global Tag Search Links (z-20 overrides full card link) -->
        <div class="flex flex-wrap gap-1.5 relative z-20">
          {tags.map((tag) => (
            <a
              href={`/tag?name=${encodeURIComponent(tag)}`}
              class="card-tag text-xs px-2.5 py-1 rounded-md font-medium border transition-colors hover:bg-amber-400 hover:text-neutral-950"
            >
              #{tag}
            </a>
          ))}
        </div>

        <span class="card-more-btn inline-flex items-center font-semibold px-3 py-1.5 rounded-full transition-colors">
          more...
        </span>
      </div>
    </div>
  </div>

  {/* Primary Card Overlay Link (Covers everything at z-10 except z-20 tags) */}
  <a href={computedHref} class="absolute inset-0 z-10" aria-label={title}></a>
</div>

<style>
  /* Image Hover Animation driven by CSS variables */
  .group:hover .card-image {
    transform: var(--card-image-zoom) var(--card-image-tilt);
  }

  /* Pinned Badge Styling */
  .card-pinned-badge {
    font-size: var(--card-pinned-size);
    background-color: var(--color-card-pinned-bg);
    color: var(--color-card-pinned-text);
  }

  /* Category Styling */
  .card-category {
    font-size: var(--card-category-size);
    color: var(--color-card-category);
  }

  /* Title Typography & Mouseover Hover Color */
  .card-title {
    font-size: var(--card-title-size);
    color: var(--color-card-title);
  }

  .group:hover .card-title {
    color: var(--color-card-title-hover);
  }

  /* Description Typography */
  .card-description {
    font-size: var(--card-description-size);
    color: var(--color-card-description);
  }

  /* Tag Pill Colors */
  .card-tag {
    background-color: var(--color-card-tag-bg);
    color: var(--color-card-tag-text);
    border-color: var(--color-card-tag-border);
  }

  /* 'More...' Action Pill Colors & Hover */
  .card-more-btn {
    font-size: var(--card-more-size);
    background-color: var(--color-card-more-bg);
    color: var(--color-card-more-text);
  }

  .group:hover .card-more-btn {
    background-color: var(--color-card-more-hover-bg);
    color: var(--color-card-more-hover-text);
  }

  /* Slanted Diagonal Divider Lines (Desktop screens 640px and wider) */
  @media (min-width: 640px) {
    .card-slant-left {
      clip-path: polygon(0 0, 100% 0, 85% 100%, 0 100%);
    }
    .card-slant-right {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 15% 100%);
    }
  }
</style>
