---
import Layout from '../layouts/Layout.astro';
import WavyBanner from '../components/WavyBanner.astro';
---

<Layout title="Contact | Eudelia's Studio">
  <!-- Site-wide Wavy Header Banner -->
  <WavyBanner
    title="Get in Touch"
    subtitle="Have a question, artwork inquiry, or just want to say hello?"
  />

  <main class="max-w-4xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">

      <!-- Left Column: Interactive Animated Email Card & Intro -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-2">Let's Connect! 👋</h2>
          <p class="text-sm opacity-80 leading-relaxed">
            Whether you want to discuss a custom piece, ask about my creative process, or just share a quick note, I'd love to hear from you.
          </p>
        </div>

        <!-- Fun Interactive Email Card -->
        <div class="group relative overflow-hidden bg-[var(--color-card-bg)] border theme-card-border p-8 rounded-2xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          
          <!-- Background Subtle Floating Glow Effect -->
          <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-amber-400/20 dark:bg-amber-400/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-500"></div>

          <!-- Modern Animated Vector Mail Icon -->
          <div class="w-14 h-14 rounded-2xl bg-amber-400/20 text-amber-500 dark:text-amber-400 flex items-center justify-center mb-4 group-hover:rotate-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-amber-500 block mb-1">Direct Email</span>
          <p class="text-xl font-extrabold tracking-tight mb-4 break-all">
            hello@eudeliaoh.com
          </p>


          <!-- Action Buttons Row -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <!-- Copy Button with Feedback -->
            <button
              id="copy-email-btn"
              type="button"
              class="px-4 py-2 rounded-full text-xs font-bold btn-theme-action flex items-center gap-2 transition-all cursor-pointer shadow-sm active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
              </svg>
              <span id="copy-text">Copy Address</span>
            </button>

            <!-- Direct Mailto Link -->
            <a
              href="mailto:hello@eudeliaoh.com"
              class="px-4 py-2 rounded-full text-xs font-semibold tag-pill-inactive hover:opacity-80 transition-all flex items-center gap-1.5"
            >
              Open Mail App ↗
            </a>
          </div>

          <!-- Copied Toast Badge (Hidden by Default) -->
          <div
            id="toast-copied"
            class="absolute top-4 right-4 bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md opacity-0 transition-opacity duration-300 pointer-events-none flex items-center gap-1"
          >
            <span>Copied! 🌸</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Theme-Aware Contact Form -->
      <div class="bg-[var(--color-card-bg)] border theme-card-border p-8 rounded-2xl shadow-md">
        <h2 class="text-xl font-bold mb-6">Send a Message</h2>

        <form class="space-y-4" action="#" method="POST">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider opacity-70 mb-1.5">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Jane Doe"
              class="w-full px-4 py-3 rounded-xl form-input-theme text-sm"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider opacity-70 mb-1.5">Your Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="jane@example.com"
              class="w-full px-4 py-3 rounded-xl form-input-theme text-sm"
            />
          </div>

          <!-- Message Subject -->
          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider opacity-70 mb-1.5">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Art Inquiry / General Question"
              class="w-full px-4 py-3 rounded-xl form-input-theme text-sm"
            />
          </div>

          <!-- Message Body -->
          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider opacity-70 mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tell me about your idea or message..."
              class="w-full px-4 py-3 rounded-xl form-input-theme text-sm resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-3 px-6 rounded-full btn-theme-action font-bold text-sm transition-all cursor-pointer shadow-md mt-2 hover:scale-[1.01] active:scale-95"
          >
            Send Message ✨
          </button>
        </form>
      </div>

    </div>
  </main>
</Layout>

<script>
  // Copy Email to Clipboard Script
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const toast = document.getElementById('toast-copied');
  const emailToCopy = 'hello@eudeliaoh.com';

  if (copyBtn && copyText && toast) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailToCopy);
        copyText.textContent = 'Copied!';
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');

        setTimeout(() => {
          copyText.textContent = 'Copy Address';
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    });
  }
</script>
