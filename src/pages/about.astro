---
import Layout from '../layouts/Layout.astro';
import WavyBanner from '../components/WavyBanner.astro';
import { getCertificates } from '../lib/sanity';

const certificates = await getCertificates();

function formatMonthYear(dateStr?: string): string {
  if (!dateStr) return '';
  const parseableDate = dateStr.length === 7 ? `${dateStr}-01` : dateStr;
  const date = new Date(parseableDate);
  if (isNaN(date.getTime())) return dateStr;
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}

const skills = [
  {
    title: "Crafts",
    description: "Handcrafting miniature clay models, paper craft prototypes, and physical sculpture studies.",
    icon: "🎨"
  },
  {
    title: "Illustrations",
    description: "Creating traditional sketches, watercolor artwork, character concepts, and visual stories.",
    icon: "🖌️"
  },
  {
    title: "Digital Art",
    description: "Designing pixel art, digital paintings, character avatars, and ambient graphic art.",
    icon: "✨"
  },
  {
    title: "Coding",
    description: "Building interactive Scratch projects, Minecraft creations, and creative experiments.",
    icon: "💻"
  }
];
---

<Layout title="About | Eudelia's Studio">
  <WavyBanner
    title="About Eudelia"
    subtitle="Artist, Craft Designer, and Digital Creator based in Singapore."
  />

  <main class="max-w-4xl mx-auto px-4 py-12 space-y-16">

    <!-- Hero Bio Section -->
    <section class="flex flex-col md:flex-row items-center gap-8 bg-[var(--color-card-bg)] border border-neutral-200 dark:border-neutral-800 p-8 rounded-2xl shadow-md">
      <!-- Profile Picture Container with Theme-Aware Accent Border -->
      <div class="w-40 h-40 md:w-48 md:h-48 shrink-0 rounded-full overflow-hidden border-4 border-[var(--color-excerpt-border)] shadow-lg">
        <img
          src="https://picsum.photos/400/400?random=10"
          alt="Eudelia Portrait"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-4 text-center md:text-left">
        <h2 class="text-2xl font-bold tracking-tight">Hello, I'm Eudelia! 👋</h2>
        <p class="opacity-90 leading-relaxed">
          Welcome to my creative space. I am a passionate artist dedicated to bringing ideas to life through physical clay models, paper craft prototypes, illustrations, digital art, and coding projects.
        </p>
        <p class="opacity-75 text-sm leading-relaxed">
          Whether exploring dynamic character poses or shaping miniature physical sculptures, I love sharing the behind-the-scenes journey and experimental techniques behind every build.
        </p>
      </div>
    </section>

    <!-- Skills Section -->
    <section>
      <div class="mb-8 text-center md:text-left">
        <h2 class="text-2xl font-bold tracking-tight">What I Create</h2>
        <p class="text-sm opacity-70">Core artistic focuses and studio projects</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {skills.map((skill) => (
          <div class="bg-[var(--color-card-bg)] border border-neutral-200 dark:border-neutral-800 p-6 rounded-2xl shadow-md hover:border-[var(--color-excerpt-border)] transition-all duration-300">
            <div class="text-3xl mb-3">{skill.icon}</div>
            <h3 class="text-lg font-bold mb-2">{skill.title}</h3>
            <p class="text-sm opacity-75 leading-relaxed">{skill.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Certificates & Recognitions Section -->
    {certificates.length > 0 && (
      <section class="space-y-8">
        <div class="text-center md:text-left">
          <h2 class="text-2xl font-bold tracking-tight">Certificates & Recognitions</h2>
          <p class="text-sm opacity-70">Click any card to expand details or view transcripts</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {certificates.map((cert) => (
            <div
              class="bg-[var(--color-card-bg)] border border-neutral-200 dark:border-neutral-800 rounded-2xl p-6 shadow-md hover:border-[var(--color-excerpt-border)] transition-all duration-300 flex flex-col justify-between space-y-4 cursor-pointer group"
              onclick={`document.getElementById('dialog-${cert._id}').showModal()`}
            >
              <div class="flex items-start gap-4">
                {cert.image && (
                  <img
                    src={cert.image}
                    alt={cert.title}
                    class="w-16 h-16 object-cover rounded-xl border border-neutral-200 dark:border-neutral-700 shrink-0 group-hover:scale-105 transition-transform"
                  />
                )}
                <div>
                  {cert.category && (
                    <span class="inline-block text-[11px] font-semibold uppercase tracking-wider text-[var(--color-card-category)] mb-1">
                      {cert.category}
                    </span>
                  )}
                  <h3 class="text-base font-bold leading-snug group-hover:text-[var(--color-card-category)] transition-colors">{cert.title}</h3>
                  <p class="text-xs opacity-75 mt-0.5">{cert.issuer}</p>
                  <p class="text-[11px] opacity-60 font-mono mt-1">{formatMonthYear(cert.issueDate)}</p>
                </div>
              </div>

              <!-- Action Row with Theme-Aware 2-Arrows Expand SVG Icon -->
              <div class="flex items-center justify-between pt-2 border-t border-neutral-100 dark:border-neutral-800 text-xs font-semibold text-[var(--color-card-category)]">
                <span>View Details & Certificate</span>
                <svg class="w-4 h-4 stroke-current group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="14" y1="10" x2="3" y2="21"></line>
                </svg>
              </div>
            </div>

            <!-- Native Desktop-Centered Lightbox Dialog -->
            <dialog
              id={`dialog-${cert._id}`}
              class="fixed inset-0 m-auto rounded-2xl p-0 max-w-xl w-[calc(100%-2rem)] h-fit max-h-[90vh] overflow-y-auto bg-[var(--color-card-bg)] text-current backdrop:bg-black/60 backdrop:backdrop-blur-sm border border-neutral-200 dark:border-neutral-800 shadow-2xl"
            >
              <div class="p-6 space-y-6">
                <!-- Header & Close Button -->
                <div class="flex items-start justify-between gap-4 border-b border-neutral-200 dark:border-neutral-800 pb-4">
                  <div>
                    {cert.category && (
                      <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-card-category)]">
                        {cert.category}
                      </span>
                    )}
                    <h3 class="text-xl font-bold">{cert.title}</h3>
                    <p class="text-xs opacity-75">{cert.issuer} • {formatMonthYear(cert.issueDate)}</p>
                  </div>
                  <form method="dialog">
                    <button class="p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-lg font-bold cursor-pointer">
                      ✕
                    </button>
                  </form>
                </div>

                <!-- Full Image View -->
                {cert.image && (
                  <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-700 max-h-80 bg-neutral-900 flex items-center justify-center">
                    <img src={cert.image} alt={cert.title} class="w-full h-full object-contain" />
                  </div>
                )}

                <!-- Description / Highlights -->
                {cert.description && (
                  <p class="text-sm opacity-80 leading-relaxed bg-neutral-50 dark:bg-neutral-900/50 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800">
                    {cert.description}
                  </p>
                )}

                <!-- Action Links -->
                <div class="flex flex-wrap gap-3 pt-2">
                  {cert.credentialUrl && (
                    <a
                      href={cert.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-4 py-2 rounded-xl font-bold text-xs transition-colors inline-flex items-center gap-1.5 bg-[var(--color-tag-active-bg)] text-[var(--color-tag-active-text)] hover:opacity-90"
                    >
                      <span>Verify Credential</span>
                      <span>↗</span>
                    </a>
                  )}
                  {cert.transcriptUrl && (
                    <a
                      href={cert.transcriptUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-4 py-2 rounded-xl border border-neutral-300 dark:border-neutral-700 font-bold text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors inline-flex items-center gap-1.5"
                    >
                      <span>📄 View Transcript (PDF)</span>
                      <span>↗</span>
                    </a>
                  )}
                </div>
              </div>
            </dialog>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>
