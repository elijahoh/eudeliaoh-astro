---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import WavyBanner from '../../components/WavyBanner.astro';
import Carousel from '../../components/Carousel.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from 'astro-portabletext';
import SanityImage from '../../components/SanityImage.astro';

const { slug } = Astro.params;

const item = await sanityClient.fetch(
  `*[_type == "portfolio" && slug.current == $slug][0]{
    title,
    category,
    description,
    "image": mainImage.asset->url,
    "additionalImages": additionalImages[].asset->url,
    "tags": tags[]->title,
    publishedAt,
    body
  }`,
  { slug }
);

if (!item) {
  return Astro.redirect('/404');
}

const categoryMap: Record<string, string> = {
  'crafts': 'Crafts',
  'illustrations': 'Illustrations',
  'digital-art': 'Digital Art',
  'coding': 'Coding',
};

const formattedCategory = categoryMap[item.category] || item.category || 'Portfolio';
const allImages = [item.image, ...(item.additionalImages || [])].filter(Boolean);

const portableTextComponents = {
  type: {
    image: SanityImage,
  },
};

---

<Layout title={`${item.title} | Portfolio`}>
  <WavyBanner title={item.title} subtitle={`${formattedCategory} • Portfolio Project`} />

  <article class="max-w-3xl mx-auto px-4 py-12">
    {/* Image Carousel */}
    {allImages.length > 0 && (
      <Carousel images={allImages} title={item.title} />
    )}

    {/* Excerpt / Summary */}
    {item.description && (
      <p class="text-xl font-medium opacity-90 leading-relaxed mb-8 excerpt-accent pl-4 italic">
        {item.description}
      </p>
    )}

    {/* Category & Tag Metadata */}
    <div class="flex flex-wrap items-center gap-2 mb-8">

      {item.category && (
        <a
          href={`/portfolio?category=${item.category}`}
          class="px-3 py-1 tag-pill-active rounded-full text-xs font-bold uppercase tracking-wide"
        >
          {formattedCategory}
        </a>
      )}

      {item.tags && item.tags.map((tag: string) => (
        <a
          href={`/portfolio?tag=${encodeURIComponent(tag)}`}
          class="px-3 py-1 tag-pill-inactive rounded-full text-xs font-semibold hover:opacity-80 transition-opacity"
        >
          #{tag}
        </a>
      ))}
    </div>

    {/* Portable Text Body Content */}
    {item.body && (
      <div class="prose dark:prose-invert max-w-none text-lg leading-relaxed space-y-6">
        <PortableText value={item.body} components={portableTextComponents} />
      </div>
    )}

  </article>
</Layout>
