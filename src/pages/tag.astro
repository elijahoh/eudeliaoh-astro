---
import Layout from '../layouts/Layout.astro';
import WavyBanner from '../components/WavyBanner.astro';
import Card from '../components/Card.astro';
import { sanityClient } from 'sanity:client';

const selectedTag = Astro.url.searchParams.get('name') || Astro.url.searchParams.get('tag') || '';

const categoryMap: Record<string, string> = {
  'crafts': 'Crafts',
  'illustrations': 'Illustrations',
  'digital-art': 'Digital Art',
  'coding': 'Coding',
  'journal': 'Journal',
};

// Query BOTH post and portfolio documents where dereferenced tag titles match
const rawItems = await sanityClient.fetch(
  `*[_type in ["portfolio", "post"] && $tag in tags[]->title] | order(publishedAt desc) {
    _id,
    _type,
    title,
    category,
    "slug": slug.current,
    "image": mainImage.asset->url,
    description,
    "tags": tags[]->title,
    publishedAt,
    readTime
  }`,
  { tag: selectedTag },
  { stega: false }
);

const items = rawItems.map((item: any) => ({
  ...item,
  formattedCategory: categoryMap[item.category] || item.category || (item._type === 'portfolio' ? 'Portfolio' : 'Blog'),
}));
---

<Layout title={`#${selectedTag} | Eudelia's Studio`}>
  <WavyBanner
    title={`#${selectedTag}`}
    subtitle={`Showing all portfolio items and blog posts tagged with #${selectedTag}`}
  />

  <main class="max-w-4xl mx-auto px-4 py-12 space-y-8">
    <div class="flex flex-col gap-6">
      {items.length > 0 ? (
        items.map((item: any, index: number) => (
          <Card
            _id={item._id}
            _type={item._type}
            title={item.title}
            category={item.formattedCategory}
            slug={item.slug}
            image={item.image}
            description={item.description}
            tags={item.tags}
            date={item.publishedAt ? item.publishedAt.split('T')[0] : ''}
            readTime={item.readTime}
            reverse={index % 2 !== 0}
          />
        ))
      ) : (
        <p class="text-neutral-400 italic text-center py-12">No content found tagged with #{selectedTag}.</p>
      )}
    </div>
  </main>
</Layout>
